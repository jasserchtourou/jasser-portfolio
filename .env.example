# Copy to .env.local for local development; set the same names in Vercel for production.
# See README → "Back office" and "Analytics (Umami)".

# --- Back office (/admin) ---
ADMIN_PASSWORD=
# 32+ random characters: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=

# Production only: commit edits to GitHub so Vercel redeploys. Leave empty locally to write files on disk.
# Fine-grained token, this repository only, "Contents: Read and write".
GITHUB_TOKEN=
GITHUB_REPO=jasserchtourou/jasser-portfolio
GITHUB_BRANCH=main

# --- Umami analytics ---
# Tracking script (public, inlined at build time)
NEXT_PUBLIC_UMAMI_URL=https://cloud.umami.is
NEXT_PUBLIC_UMAMI_WEBSITE_ID=312179cc-a747-4f7e-8c13-0dcab455ec31
# NEXT_PUBLIC_UMAMI_DOMAINS=jasser-portfolio-topaz.vercel.app

# Stats for /admin/analytics (server only), one of:
# a) Share URL, any plan incl. free Hobby (Websites → Edit → Share URL → enable):
UMAMI_SHARE_URL=
# b) Umami Cloud API key (paid plans): UMAMI_API_URL=https://api.umami.is/v1 and
# UMAMI_API_KEY=
# c) Self-hosted: UMAMI_API_URL=https://<umami>/api, UMAMI_USERNAME=, UMAMI_PASSWORD=
# UMAMI_DASHBOARD_URL=
